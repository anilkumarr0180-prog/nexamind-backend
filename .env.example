NODE_ENV=development
PORT=5001
CORS_ORIGINS=http://localhost:5173

MONGODB_URI=
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# AI Provider: "ollama" or "groq"
AI_PROVIDER=ollama

# Ollama Local Configuration (when AI_PROVIDER=ollama)
AI_MODEL=llama3.2:3b
AI_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=60000

# Groq Cloud Configuration (when AI_PROVIDER=groq)
GROQ_API_KEY= # required if AI_PROVIDER=groq
# For Groq, set AI_MODEL to a Groq model (e.g. qwen/qwen3.8-27b, llama-3.3-70b-versatile)

# Context & Memory Controls
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONTEXT_CHARS=32000
AI_MAX_MEMORY_CONTEXT=10
AI_MAX_EXTRACTED_MEMORIES_PER_CHAT=3
AI_EMBEDDING_MODEL=nomic-embed-text
AI_MEMORY_SEMANTIC_SEARCH_ENABLED=true

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=50

# Polar Billing Provider (Phase 1+)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

POLAR_PRODUCT_PLUS_MONTHLY=
POLAR_PRODUCT_PLUS_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=