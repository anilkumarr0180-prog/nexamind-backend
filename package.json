        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.5.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
